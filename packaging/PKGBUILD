# Maintainer: 9Spokes OSS
pkgname=omarchy-himmelblau
pkgver=0.2.0
pkgrel=1
pkgdesc='Experimental explicit Omarchy companion for an existing Himmelblau installation'
arch=('x86_64')
url='https://github.com/9spokes-oss/omarchy-himmelblau'
license=('MIT')
depends=('himmelblau>=4.0.8' 'omarchy' 'python' 'patch' 'pam')
makedepends=('make')
# Build from a reviewed checkout; no install hooks or network/source substitution.
source=()
_repo="${OMARCHY_HIMMELBLAU_SRC:-${startdir%/packaging}}"
build() {
  make -B -C "$_repo" build/pin-change
}
package() {
  make -C "$_repo" DESTDIR="$pkgdir" install
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
