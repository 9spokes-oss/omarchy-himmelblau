{
  "schemaVersion": 1,
  "id": "9spokes.warp",
  "name": "Cloudflare WARP",
  "version": "0.1.0",
  "author": "9Spokes OSS",
  "license": "MIT",
  "description": "Theme-aware Cloudflare WARP / Zero Trust status, connect toggle and sign-in in the Omarchy bar. Needs warp-svc and warp-cli.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Cloudflare WARP",
    "description": "WARP connection state; click for details, right-click to connect or disconnect.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "listenForChanges": true,
      "warpCli": "warp-cli"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "listenForChanges",
        "type": "boolean",
        "label": "Refresh on daemon events (warp-cli -l)",
        "defaultValue": true
      },
      {
        "key": "warpCli",
        "type": "string",
        "label": "warp-cli command",
        "defaultValue": "warp-cli"
      }
    ]
  }
}
