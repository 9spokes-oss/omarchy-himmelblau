#!/bin/sh
# Stand-in for warp-cli in the offscreen harness. State lives in $FAKE_WARP_STATE
# (one word); every call is logged to $FAKE_WARP_STATE.log. Touch
# $FAKE_WARP_STATE.locked to make disconnect fail as an admin policy would, and
# $FAKE_WARP_STATE.nolisten to make `-l status` exit at once.
state_file=${FAKE_WARP_STATE:?}
echo "$*" >>"$state_file.log"
[ "$1" = --accept-tos ] && shift
state=$(cat "$state_file" 2>/dev/null || echo connected)
[ "$1" = -j ] && shift

case "$1 ${2:-}" in
  "-l status")
    [ -e "$state_file.nolisten" ] && exit 1
    exec sleep 3600 ;;
  "status ")
    case $state in
      connected)    echo '{"status":"Connected","reason":"NetworkHealthy"}' ;;
      disconnected) echo '{"status":"Disconnected","reason":"ManualDisconnection"}' ;;
      connecting)   echo '{"status":"Connecting","reason":{"PerformingHappyEyeballs":[1,2]}}' ;;
      unregistered) echo '{"status":"Disconnected","reason":{"RegistrationMissing":"DaemonStartup"}}' ;;
      unable)       echo '{"status":"Unable","reason":{"TLSInterceptionBlockingDOH":{"gateway_url":"x"}}}' ;;
      daemon-down)  printf '{\n  "code": "FailedToConnectToDaemon",\n  "error": "No such file or directory (os error 2)"\n}\n'; exit 1 ;;
    esac ;;
  "registration show")
    [ "$state" = unregistered ] && { echo '{"code":"MissingRegistration"}'; exit 1; }
    echo '{"id":"x","device_id":"y","public_key":"z","managed":true,"account":{"type":"Team","id":"a","organization":"example-team"}}' ;;
  "registration new")
    # No URL on purpose: the harness must not launch a browser.
    echo "Registration in progress, finish signing in in your browser"
    sleep 3
    echo connected >"$state_file"
    echo Success ;;
  "connect ")
    echo connected >"$state_file"; echo Success ;;
  "disconnect ")
    if [ -e "$state_file.locked" ]; then echo "Error: Disconnect is disabled by your administrator" >&2; exit 1; fi
    echo disconnected >"$state_file"; echo Success ;;
  *) echo "fake: unsupported $*" >&2; exit 2 ;;
esac
