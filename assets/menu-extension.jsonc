{
  "work-account": {
    "label": "Work account"
  },
  "work-account.status": {
    "label": "Integration status",
    "action": "omarchy-launch-terminal bash -lc 'omarchy-himmelblau status; read -r -p \"Press Enter to close\"'"
  }
